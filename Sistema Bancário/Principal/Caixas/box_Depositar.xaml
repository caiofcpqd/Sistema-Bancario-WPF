<Window x:Class="Sistema_Bancário.Principal.box_Depositar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depositar"
        Height="430"
        Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="AccountSelector"
               TargetType="RadioButton">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Width"
                    Value="150"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#666666"/>

            <Setter Property="BorderBrush"
                    Value="#D8D8D8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4B168C"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#4B168C"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#4B168C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8D8D8"
            BorderThickness="1"
            CornerRadius="10">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Depositar dinheiro"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#222222"/>

                <TextBlock Text="Informe o valor e escolha a conta para o depósito."
                           FontSize="13"
                           Foreground="#777777"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,25,0,0">

                <TextBlock Text="CONTA PARA DEPÓSITO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,8"/>

                <Border Background="#F5F5F5"
                        CornerRadius="8"
                        Padding="3">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton x:Name="rbContaCorrente"
                                     Content="Conta corrente"
                                     GroupName="TipoConta"
                                     IsChecked="True"
                                     Style="{StaticResource AccountSelector}"/>

                        <RadioButton x:Name="rbPoupanca"
                                     Content="Poupança"
                                     GroupName="TipoConta"
                                     Style="{StaticResource AccountSelector}"
                                     Margin="3,0,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Center">

                <TextBlock Text="VALOR DO DEPÓSITO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,8"/>

                <Border Background="#F8F8F8"
                        BorderBrush="#D8D8D8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="52">

                    <Grid>

                        <TextBlock Text="R$"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>

                        <TextBox x:Name="txtValorDeposito"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="#333333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="45,0,15,0"/>

                    </Grid>

                </Border>

                <TextBlock x:Name="lbContaSelecionada"
                           Text="O depósito será realizado na conta corrente."
                           FontSize="11"
                           Foreground="#999999"
                           Margin="2,7,0,0"/>

            </StackPanel>

            <Grid Grid.Row="3"
                  Margin="0,15,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="120"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Width="110"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ActionButton}"
                        Background="White"
                        Foreground="#555555"
                        BorderBrush="#D5D5D5"
                        Click="CancelarButton_Click"/>

                <Button Grid.Column="1"
                        Content="Depositar"
                        Width="120"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ActionButton}"
                        Background="#4B168C"
                        Foreground="White"
                        BorderBrush="#4B168C"
                        Click="DepositarButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>