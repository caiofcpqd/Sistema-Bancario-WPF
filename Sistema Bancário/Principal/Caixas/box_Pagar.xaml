<Window x:Class="Sistema_Bancário.Principal.box_Pagar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagar"
        Height="450"
        Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="AccountSelector"
               TargetType="RadioButton">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Width"
                    Value="135"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#666666"/>

            <Setter Property="BorderBrush"
                    Value="#D8D8D8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4B168C"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#4B168C"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#4B168C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8D8D8"
            BorderThickness="1"
            CornerRadius="10">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Realizar pagamento"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#222222"/>

                <TextBlock Text="Informe os dados do pagamento que deseja realizar."
                           FontSize="13"
                           Foreground="#777777"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Top"
                        Margin="0,22,0,0">

                <TextBlock Text="CONTA PARA PAGAMENTO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,7"/>

                <Border Background="#F8F8F8"
                        CornerRadius="7"
                        Padding="3"
                        HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton x:Name="rbContaCorrente"
                                     Content="Conta corrente"
                                     GroupName="TipoConta"
                                     Style="{StaticResource AccountSelector}"
                                     IsChecked="True"/>

                        <RadioButton x:Name="rbPoupanca"
                                     Content="Poupança"
                                     GroupName="TipoConta"
                                     Style="{StaticResource AccountSelector}"
                                     Margin="3,0,0,0"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="CPF DO DESTINATÁRIO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,16,0,7"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="105"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8F8F8"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="48">

                        <TextBox x:Name="txtDestinatario"
                                 FontSize="14"
                                 Foreground="#333333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="14,0"/>

                    </Border>

                    <Button Grid.Column="1"
                            Content="Verificar"
                            Height="48"
                            Margin="8,0,0,0"
                            Background="#4B168C"
                            Foreground="White"
                            BorderBrush="#4B168C"
                            BorderThickness="1"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="VerificarCpfButton_Click"/>

                </Grid>

                <TextBlock x:Name="lbNomeDestinatario"
                           Text=""
                           FontSize="12"
                           Foreground="#4B168C"
                           FontWeight="SemiBold"
                           Margin="3,6,0,0"/>

                <TextBlock Text="VALOR"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,14,0,7"/>

                <Border Background="#F8F8F8"
                        BorderBrush="#D8D8D8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="48">

                    <Grid>

                        <TextBlock Text="R$"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"/>

                        <TextBox x:Name="txtValorPagamento"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#333333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="45,0,14,0"/>

                    </Grid>

                </Border>

            </StackPanel>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="120"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Width="110"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ActionButton}"
                        Background="White"
                        Foreground="#555555"
                        BorderBrush="#D5D5D5"
                        Click="CancelarButton_Click"/>

                <Button Grid.Column="1"
                        Content="Pagar"
                        Width="120"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ActionButton}"
                        Background="#4B168C"
                        Foreground="White"
                        BorderBrush="#4B168C"
                        Click="PagarButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>